diff --git a/src/main/scala/util/FillAwareReplacement.scala b/src/main/scala/util/FillAwareReplacement.scala
new file mode 100644
index 000000000..3f9b91544
--- /dev/null
+++ b/src/main/scala/util/FillAwareReplacement.scala
@@ -0,0 +1,28 @@
+// ECE 462/562 linear-regression cache replacement project: dcache-exact-fill patch.
+package freechips.rocketchip.util
+
+import chisel3._
+
+/** A per-set ReplacementPolicy that wants extra information on every touch.
+  *
+  * The stock DCache only calls get_next_state(state, way) on hits, and never
+  * reports refills. When the policy mixes in this trait, the patched DCache
+  * calls get_next_state_touch instead, with:
+  *  - isInsert: this touch is the first access to a line the D$ just refilled
+  *    into touch_way (the replay of the miss). This is exact, not inferred
+  *    from the victim choice.
+  *  - isWrite:  the access is a store (or AMO).
+  *
+  * Victim selection is unchanged: the DCache still calls get_replace_way(state).
+  */
+trait FillAwareReplacement { this: ReplacementPolicy =>
+  def get_next_state_touch(state: UInt, touch_way: UInt, isInsert: Bool, isWrite: Bool): UInt
+}
+
+/** True LRU routed through the fill-aware path. It ignores the extra inputs, so
+  * it must produce cycle-for-cycle the same results as "lru". Use it to check
+  * the patch is applied and elaborates. Policy string: "lru-exact". */
+class ExactFillLRU(n_ways: Int) extends TrueLRU(n_ways) with FillAwareReplacement {
+  def get_next_state_touch(state: UInt, touch_way: UInt, isInsert: Bool, isWrite: Bool): UInt =
+    get_next_state(state, touch_way)
+}
